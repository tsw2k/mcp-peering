# Peering Manager (your local installation)
PEERING_MANAGER_URL=https://peering-manager.example.com
PEERING_MANAGER_TOKEN=your-api-token-here
# Set to "false" to disable TLS verification (self-signed certs); default true.
PEERING_MANAGER_VERIFY_SSL=true

# PeeringDB
# Public PeeringDB API. Override only if using a mirror.
PEERINGDB_URL=https://www.peeringdb.com/api
# Optional API key (https://docs.peeringdb.com/howto/api_keys/).
# Without a key only public data is reachable; some objects (e.g. POC) require auth.
PEERINGDB_API_KEY=
# Alternatively use HTTP Basic auth (legacy):
PEERINGDB_USERNAME=
PEERINGDB_PASSWORD=

# HTTP client tuning
HTTP_TIMEOUT=30
