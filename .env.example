# Peering Manager (your local installation)
PEERING_MANAGER_URL=https://peering-manager.example.com
PEERING_MANAGER_TOKEN=your-api-token-here
# Set to "false" to disable TLS verification (self-signed certs); default true.
PEERING_MANAGER_VERIFY_SSL=true
# Set to "true" for read-only mode: mutating tools (pm_create/pm_update/
# pm_delete, AS sync, session polling) are not registered at all and the
# client rejects write requests. Combine with a read-only API token.
PM_READONLY=false

# PeeringDB
# Public PeeringDB API. Override only if using a mirror.
PEERINGDB_URL=https://www.peeringdb.com/api
# Optional API key (https://docs.peeringdb.com/howto/api_keys/).
# Without a key only public data is reachable; some objects (e.g. POC) require auth.
PEERINGDB_API_KEY=
# Alternatively use HTTP Basic auth (legacy):
PEERINGDB_USERNAME=
PEERINGDB_PASSWORD=

# Seconds to cache PeeringDB GET responses (LRU); 0 disables caching.
PEERINGDB_CACHE_TTL=300
# Maximum number of cached responses kept.
PEERINGDB_CACHE_SIZE=128
# Outbound PeeringDB request cap, requests per second; 0 disables the limit.
PEERINGDB_RATE_LIMIT=2

# HTTP client tuning (for outbound calls to PM/PeeringDB)
HTTP_TIMEOUT=30

# ---------------------------------------------------------------------------
# Transport (how Claude / your MCP client talks to this server)
# ---------------------------------------------------------------------------
# stdio (default) - local process spawned by the client.
# streamable-http - recommended for network deployments. One HTTP endpoint.
# sse             - legacy SSE transport, still supported by most clients.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Path the transport is mounted on (defaults: /mcp for streamable-http, /sse for sse).
MCP_PATH=

# Optional bearer token required on incoming HTTP/SSE requests.
# Clients must send: Authorization: Bearer <token>. Leave empty to disable
# (only safe behind a trusted reverse proxy).
MCP_AUTH_TOKEN=
